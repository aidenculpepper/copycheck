<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
<Product Id="53DA3BA1-32F5-4B64-8BFD-3DF0744A1B19" Name="CopyCheck MSI Preview" Language="1033" Version="1.0.13" Manufacturer="CopyCheck" UpgradeCode="FA5B475D-E63B-4A67-B350-4E63D482EFA4">
<Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" Description="Reversible side-by-side CopyCheck MSI experiment" />
<MajorUpgrade DowngradeErrorMessage="A newer CopyCheck MSI Preview is already installed." />
<MediaTemplate EmbedCab="yes" />
<Icon Id="CopyCheckIcon" SourceFile="CopyCheck.ico" /><Property Id="ARPPRODUCTICON" Value="CopyCheckIcon" />
<Property Id="ARPHELPLINK" Value="https://github.com/aidenculpepper/copycheck" />
<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" /><Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch CopyCheck MSI Preview" /><Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
<Property Id="WixShellExecTarget" Value="[#CopyCheckExe]" />
<CustomAction Id="LaunchPreview" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
<UI><UIRef Id="WixUI_FeatureTree" /><Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPreview">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish></UI>
<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
<Directory Id="TARGETDIR" Name="SourceDir">
<Directory Id="LocalAppDataFolder"><Directory Id="PreviewPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="CopyCheck MSI Preview">
<Component Id="ApplicationFiles" Guid="ECBA9356-910C-4B0D-A1DA-C51E17FA87D5" Win64="yes"><File Id="CopyCheckExe" Source="CopyCheck.exe" /><File Id="AppIcon" Source="CopyCheck.ico" /><File Id="PreviewMarker" Source="msi-preview.flag" /><RegistryValue Root="HKCU" Key="Software\CopyCheckMsiPreview" Name="Installed" Type="integer" Value="1" KeyPath="yes" /><RemoveFolder Id="RemoveInstall" Directory="INSTALLFOLDER" On="uninstall" /><RemoveFolder Id="RemovePrograms" Directory="PreviewPrograms" On="uninstall" /></Component>
</Directory></Directory></Directory>
<Directory Id="ProgramMenuFolder"><Directory Id="PreviewMenu" Name="CopyCheck MSI Preview"><Component Id="MenuShortcut" Guid="*" Win64="yes"><Shortcut Id="MenuLink" Name="CopyCheck MSI Preview" Target="[INSTALLFOLDER]CopyCheck.exe" WorkingDirectory="INSTALLFOLDER" Icon="CopyCheckIcon" /><RemoveFolder Id="RemoveMenu" On="uninstall" /><RegistryValue Root="HKCU" Key="Software\CopyCheckMsiPreview" Name="Menu" Type="integer" Value="1" KeyPath="yes" /></Component></Directory></Directory>
<Directory Id="DesktopFolder"><Component Id="DesktopShortcut" Guid="*" Win64="yes"><Shortcut Id="DesktopLink" Name="CopyCheck MSI Preview" Target="[INSTALLFOLDER]CopyCheck.exe" WorkingDirectory="INSTALLFOLDER" Icon="CopyCheckIcon" /><RegistryValue Root="HKCU" Key="Software\CopyCheckMsiPreview" Name="Desktop" Type="integer" Value="1" KeyPath="yes" /></Component></Directory>
<Directory Id="StartupFolder"><Component Id="StartupShortcut" Guid="*" Win64="yes"><Shortcut Id="StartupLink" Name="CopyCheck MSI Preview" Target="[INSTALLFOLDER]CopyCheck.exe" WorkingDirectory="INSTALLFOLDER" Icon="CopyCheckIcon" /><RegistryValue Root="HKCU" Key="Software\CopyCheckMsiPreview" Name="Startup" Type="integer" Value="1" KeyPath="yes" /></Component></Directory>
</Directory>
<Feature Id="Core" Title="CopyCheck MSI Preview" Level="1" Absent="disallow"><ComponentRef Id="ApplicationFiles" /><ComponentRef Id="MenuShortcut" /></Feature>
<Feature Id="Desktop" Title="Desktop shortcut" Description="Create a matching checkmark shortcut on the desktop." Level="2"><ComponentRef Id="DesktopShortcut" /></Feature>
<Feature Id="Startup" Title="Start on startup" Description="Start the preview at sign-in." Level="1"><ComponentRef Id="StartupShortcut" /></Feature>
</Product></Wix>